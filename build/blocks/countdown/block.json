{
	"apiVersion": 3,
	"name": "genial-blocks/countdown",
	"version": "0.3.0",
	"title": "Countdown",
	"category": "genial-blocks",
	"icon": "clock",
	"description": "A deterministic client-side countdown to a selected UTC date and time.",
	"keywords": [ "countdown", "timer", "date", "Genial" ],
	"textdomain": "genial-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"attributes": {
		"targetDate": {
			"type": "string",
			"default": "2030-01-01T00:00:00.000Z"
		},
		"completionMessage": {
			"type": "string",
			"source": "html",
			"selector": ".genial-blocks-countdown__complete",
			"default": "The moment has arrived."
		},
		"numberColor": { "type": "string", "default": "" },
		"labelColor": { "type": "string", "default": "" },
		"itemBackground": { "type": "string", "default": "" },
		"borderColor": { "type": "string", "default": "" },
		"borderRadius": { "type": "number", "default": 8 },
		"gap": { "type": "number", "default": 12 },
		"alignment": {
			"type": "string",
			"enum": [ "left", "center", "right" ],
			"default": "center"
		}
	},
	"supports": {
		"align": [ "left", "center", "right", "wide", "full" ],
		"anchor": true,
		"spacing": { "margin": true, "padding": true },
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true
		}
	}
}
