{
  "name": "genialsouls/genial-blocks",
  "description": "Development tooling for Genial Blocks.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint:php": "phpcs --standard=phpcs.xml",
    "lint:compatibility": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 7.4-8.5 genial-blocks.php includes uninstall.php"
  }
}
